+/* Diagnostic opt-in: retain EFI's link through s2idle on this one board. */
+static bool macbook81_preserve_s2idle;
+module_param(macbook81_preserve_s2idle, bool, 0444);
+MODULE_PARM_DESC(macbook81_preserve_s2idle,
+	"Experimental MacBook8,1 s2idle controller/link preservation");
+
+static bool macbook81_keep_s2idle_link(struct azx *chip)
+{
+	struct pci_dev *pci = chip->pci;
+
+	return macbook81_preserve_s2idle &&
+		pm_suspend_target_state == PM_SUSPEND_TO_IDLE &&
+		dmi_match(DMI_PRODUCT_NAME, "MacBook8,1") &&
+		pci->vendor == 0x8086 && pci->device == 0x9ca0 &&
+		pci->subsystem_vendor == 0x8086 &&
+		pci->subsystem_device == 0x7270;
+}
