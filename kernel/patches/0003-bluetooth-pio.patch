--- a/drivers/tty/serial/8250/8250_lpss.c
+++ b/drivers/tty/serial/8250/8250_lpss.c
@@ -1,3 +1,4 @@
+#include <linux/dmi.h>
 // SPDX-License-Identifier: GPL-2.0
 /*
  * 8250_lpss.c - Driver for UART on Intel Braswell and various other Intel SoCs
@@ -353,9 +354,18 @@
 
 	dw8250_setup_port(&uart.port);
 
-	ret = lpss8250_dma_setup(lpss, &uart);
-	if (ret)
-		goto err_exit;
+	/* The internal Bluetooth UART stalls with LPSS DMA on MacBook8,1.
+	 * Keep the DMA controller available to all other peripherals.
+	 */
+	if (pdev->device == PCI_DEVICE_ID_INTEL_BDW_UART1 &&
+	    dmi_match(DMI_SYS_VENDOR, "Apple Inc.") &&
+	    dmi_match(DMI_PRODUCT_NAME, "MacBook8,1")) {
+		dev_info(&pdev->dev, "MacBook8,1: using PIO for Bluetooth UART\n");
+	} else {
+		ret = lpss8250_dma_setup(lpss, &uart);
+		if (ret)
+			goto err_exit;
+	}
 
 	ret = serial8250_register_8250_port(&uart);
 	if (ret < 0)
