MacBook8,1 SPI keyboard/trackpad quirk, adapted for Linux 6.18.64.
Based on Shih-Yuan Lee's GPL-2.0-only driver patch:
https://lists.openwall.net/linux-kernel/2026/09/30/2141
The original patch targets a newer driver layout; this adaptation retains
its model/device-specific PIO workaround and runtime-PM default.

--- a/drivers/spi/spi-pxa2xx-pci.c
+++ b/drivers/spi/spi-pxa2xx-pci.c
@@ -7,6 +7,7 @@
  */
 #include <linux/clk-provider.h>
 #include <linux/device.h>
+#include <linux/dmi.h>
 #include <linux/err.h>
 #include <linux/module.h>
 #include <linux/pci.h>
@@ -93,6 +94,16 @@
 	pci_dev_put(dma_dev);
 }
 
+/* MacBook8,1 firmware leaves the companion DMA controller unusable.
+ * Adapted from Shih-Yuan Lee's 2026-09-30 v17 SPI quirk for Linux 6.18.
+ */
+static bool pxa2xx_spi_is_macbook81(struct pci_dev *dev)
+{
+	return dev->device == PCI_DEVICE_ID_INTEL_LPT1_1 &&
+		dmi_match(DMI_SYS_VENDOR, "Apple Inc.") &&
+		!strcmp(dmi_get_system_info(DMI_PRODUCT_NAME) ?: "", "MacBook8,1");
+}
+
 static int lpss_spi_setup(struct pci_dev *dev, struct pxa2xx_spi_controller *c)
 {
 	struct ssp_device *ssp = &c->ssp;
@@ -149,6 +160,12 @@
 	if (ret)
 		return ret;
 
+	if (pxa2xx_spi_is_macbook81(dev)) {
+		pci_info(dev, "MacBook8,1: using PIO for the internal keyboard and trackpad\n");
+		c->enable_dma = 0;
+		return 0;
+	}
+
 	dma_dev = pci_get_slot(dev->bus, PCI_DEVFN(PCI_SLOT(dev->devfn), 0));
 	ret = devm_add_action_or_reset(&dev->dev, lpss_dma_put_device, dma_dev);
 	if (ret)
@@ -303,7 +320,9 @@
 	pm_runtime_set_autosuspend_delay(&dev->dev, 50);
 	pm_runtime_use_autosuspend(&dev->dev);
 	pm_runtime_put_autosuspend(&dev->dev);
-	pm_runtime_allow(&dev->dev);
+	/* Avoid dropped input while the MacBook8,1 controller operates in PIO. */
+	if (!pxa2xx_spi_is_macbook81(dev))
+		pm_runtime_allow(&dev->dev);
 
 	return 0;
 }
